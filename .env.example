# Copia este archivo a .env y ajusta los valores para tu entorno local.
# docker compose lo lee automáticamente. .env está en .gitignore: nunca se commitea.

# Contraseña del usuario postgres del contenedor local.
POSTGRES_PASSWORD=Local_dev_password_123

# Entorno de ASP.NET Core para el contenedor de la API.
ASPNETCORE_ENVIRONMENT=Development

# Prefijo del registry al publicar la imagen (déjalo vacío para builds locales).
# Ej: DOCKER_REGISTRY=ghcr.io/greensystems/
DOCKER_REGISTRY=
