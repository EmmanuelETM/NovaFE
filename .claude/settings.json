{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "{ python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/sync-docs-slnx.py\" || python \"$CLAUDE_PROJECT_DIR/.claude/hooks/sync-docs-slnx.py\" ; } 2>/dev/null || true",
            "timeout": 15,
            "statusMessage": "Sincronizando docs/ con NovaFE.slnx"
          }
        ]
      }
    ]
  }
}
