# Copia este archivo a .env.local. Nunca commitees .env.local.

# Base de la API NovaFE, sin barra final. Según cómo la levantes:
#   - `dotnet run --project src/Service`  -> http://localhost:5071
#   - Visual Studio F5 / `docker compose up` -> http://localhost:8080
# OJO: cada una usa una BD distinta (dotnet run = user-secrets/Neon;
# docker compose = el Postgres del contenedor), así que el tenant de
# APP_DEV_TENANT_ID tiene que existir en LA que estés usando.
APP_API_URL=http://localhost:8080

# NovaFE versiona por ruta: /api/v1/...
APP_API_VERSION=v1

# ---------------------------------------------------------------------------
# Identidad de desarrollo. Solo se usa cuando NODE_ENV != production.
#
# NovaFE acepta el esquema `DevTenantHeader` SOLO en Development: la cabecera
# `X-Tenant-Id: <guid>` sin credencial, con rol fijo `admin_tenant` y el
# ambiente del `DefaultEnvironment` del perfil del emisor. Ver `docs/api-auth.md`.
#
# `identityHeaders()` en `lib/api/server.ts` es la unica costura: el dia que
# exista la autenticacion humana (BetterAuth) se cambia ahi y ninguna pantalla
# se entera.
#
# Pon aqui el id de un contribuyente ya registrado (POST /api/v1/tenants o
# POST /api/v1/dev/sandbox).
# ---------------------------------------------------------------------------
APP_DEV_TENANT_ID=

# ===========================================================================
# Auth humana — Better Auth self-hosted (ver el plan human-auth).
# Todavia OPCIONAL: el scaffold existe pero aun no esta cableado al flujo.
# ===========================================================================

# Postgres para Better Auth (schema `auth`). El mismo Neon que la API.
# Endpoint DIRECTO (no -pooler). Recomendado: un branch de Neon para dev.
DATABASE_URL=

# openssl rand -base64 32
BETTER_AUTH_SECRET=

# URL publica del dashboard (base de los callbacks de OAuth). En local:
BETTER_AUTH_URL=http://localhost:3000

# Secreto compartido con la API .NET (cabecera X-Internal-Key). Debe coincidir
# con `Security:InternalApiKey` de la API. openssl rand -hex 32
INTERNAL_API_KEY=

# --- OAuth. Redirect URI en cada provider:
#     {BETTER_AUTH_URL}/api/auth/callback/{google|github|microsoft}
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# `common` = cualquier cuenta Microsoft (personal + organizacional). Opcional.
MICROSOFT_TENANT_ID=common
