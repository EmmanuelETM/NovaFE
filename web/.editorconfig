# El dashboard es un proyecto aparte del backend .NET: su formato lo manda
# Prettier (2 espacios, LF), no el .editorconfig de la raíz (4 espacios, CRLF).
# `root = true` corta la búsqueda hacia arriba.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
