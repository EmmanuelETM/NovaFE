<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Capa de Infraestructura: implementa las interfaces declaradas en Application
    (repositorios, unidad de trabajo, clientes HTTP externos).

    La elección de ORM vive AQUÍ y no debe filtrarse a Application ni a Service.
  -->
  <ItemGroup Label="Dapper">
    <PackageReference Include="Dapper" />
    <PackageReference Include="Npgsql" />
  </ItemGroup>

  <ItemGroup Label="EF Core">
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="EFCore.NamingConventions" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup Label="Resiliencia para clientes HTTP externos">
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
  </ItemGroup>

  <ItemGroup Label="Caché">
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" />
  </ItemGroup>

  <ItemGroup Label="Options validadas al arrancar">
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Application\NovaFE.Application.csproj" />
  </ItemGroup>

</Project>
