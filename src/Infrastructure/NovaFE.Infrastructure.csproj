<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Capa de Infraestructura: implementa las interfaces declaradas en Application
    (repositorios, unidad de trabajo, clientes HTTP externos).

    La elección de ORM vive AQUÍ y no debe filtrarse a Application ni a Service.
  -->
  <ItemGroup Label="Dapper">
    <PackageReference Include="Dapper" />
    <PackageReference Include="Npgsql" />
  </ItemGroup>

  <ItemGroup Label="EF Core">
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="EFCore.NamingConventions" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup Label="Resiliencia para clientes HTTP externos">
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
  </ItemGroup>

  <ItemGroup Label="Caché">
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" />
  </ItemGroup>

  <ItemGroup Label="Firma XMLDSig">
    <PackageReference Include="System.Security.Cryptography.Xml" />
  </ItemGroup>

  <ItemGroup Label="Representación Impresa (Módulo 9)">
    <PackageReference Include="QuestPDF" />
    <PackageReference Include="QRCoder" />
  </ItemGroup>

  <ItemGroup Label="Options validadas al arrancar">
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" />
  </ItemGroup>

  <ItemGroup Label="XSD oficiales de la DGII (vendorizados) — validación de e-CF">
    <EmbeddedResource Include="Ecf\Xsd\*.xsd" />
  </ItemGroup>

  <ItemGroup Label="Fuente Geist (OFL) embebida — Representación Impresa">
    <EmbeddedResource Include="Representation\Fonts\*.ttf" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Application\NovaFE.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Las pruebas ejercen tipos internos (vault, key protector). -->
    <InternalsVisibleTo Include="NovaFE.UnitTests" />
    <InternalsVisibleTo Include="NovaFE.IntegrationTests" />
  </ItemGroup>

</Project>
