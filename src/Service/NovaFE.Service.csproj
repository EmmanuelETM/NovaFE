<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Capa de presentación: controllers, middlewares y el bootstrapping de la API.
    Es el único proyecto ejecutable y el "composition root" de la inyección de dependencias.
  -->
  <PropertyGroup>
    <!-- Para el connection string local: dotnet user-secrets set "ConnectionStrings:Default" "..." -->
    <UserSecretsId>3418264b-4758-4dcc-a345-43a12c2e8c1d</UserSecretsId>

    <!--
      Herramientas de contenedores de Visual Studio. El Dockerfile está en esta
      carpeta (src/Service/Dockerfile) pero su contexto de build es la raíz del
      repositorio, de ahí DockerfileContext. Habilita el perfil de arranque
      "Container (Dockerfile)" y el "Fast Mode" de depuración; DockerComposeProjectPath
      enlaza este proyecto con la orquestación docker-compose.
    -->
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <DockerfileContext>..\..</DockerfileContext>
    <DockerComposeProjectPath>..\..\docker-compose.dcproj</DockerComposeProjectPath>
  </PropertyGroup>

  <ItemGroup Label="API">
    <PackageReference Include="Asp.Versioning.Mvc" />
    <PackageReference Include="Asp.Versioning.Mvc.ApiExplorer" />
    <PackageReference Include="Asp.Versioning.OpenApi" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.IO.RecyclableMemoryStream" />
    <PackageReference Include="Scalar.AspNetCore" />
  </ItemGroup>

  <ItemGroup Label="Salud y observabilidad">
    <PackageReference Include="AspNetCore.HealthChecks.Npgsql" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" />
    <PackageReference Include="Npgsql.OpenTelemetry" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Enrichers.Environment" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

  <ItemGroup Label="Herramientas de EF Core">
    <!-- Necesario para que `dotnet ef` encuentre el DbContext desde el proyecto de arranque. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup Label="Herramientas de contenedores (Visual Studio)">
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Application\NovaFE.Application.csproj" />
    <ProjectReference Include="..\Domain\NovaFE.Domain.csproj" />
    <ProjectReference Include="..\Infrastructure\NovaFE.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="NovaFE.IntegrationTests" />
  </ItemGroup>

</Project>
