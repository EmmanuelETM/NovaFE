{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/app-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ]
  },
  "ConnectionStrings": {
    "Default": ""
  },
  "Database": {
    "// Provider": "'neon' sube el connect timeout (cold start) y exige SSL VerifyFull. Ver docs/deployment.md",
    "Provider": "neon",
    "RequireSsl": true
  },
  "CertificateVault": {
    "// nota": "En producción la KEK va en Azure Key Vault. Definir por variable de entorno:",
    "// CertificateVault__Provider": "azure-key-vault",
    "// CertificateVault__KeyVaultKeyUri": "https://<vault>.vault.azure.net/keys/cert-kek",
    "// credencial": "DefaultAzureCredential — managed identity de la Container App con rol 'Key Vault Crypto User'. Ver docs/certificates.md y docs/deployment.md"
  },
  "AllowedHosts": "*"
}