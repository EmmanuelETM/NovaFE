{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ]
  },
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=NovaFE;Username=postgres;Password=postgres"
  },
  "CertificateVault": {
    "// nota": "SOLO desarrollo. En producción va por variable de entorno / KMS. Ver docs/certificates.md",
    "MasterKey": "Ol3TYr5Inh5M1vIwu2i6AuVKh77YSq0znUTN/tjlplk="
  },
  "Database": {
    "MigrateOnStartup": true,
    "EnableDetailedErrors": true,
    "EnableSensitiveDataLogging": true
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000", "http://localhost:5173" ]
  },
  "RateLimiting": {
    "Enabled": false
  }
}
