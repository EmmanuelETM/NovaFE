root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,xml,csproj,props,targets,slnx}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
indent_size = 4
csharp_using_directive_placement = outside_namespace:warning
csharp_style_namespace_declarations = file_scoped:warning
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

# --- var vs tipo explícito ---
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion

# --- Miembros con cuerpo de expresión ---
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_constructors = false:suggestion
csharp_style_expression_bodied_properties = true:suggestion
csharp_style_expression_bodied_accessors = true:suggestion
csharp_style_expression_bodied_lambdas = true:suggestion

# --- Sintaxis moderna de C# ---
csharp_style_prefer_primary_constructors = true:suggestion
csharp_style_prefer_pattern_matching = true:suggestion
csharp_style_prefer_switch_expression = true:suggestion
csharp_style_prefer_range_operator = true:suggestion
csharp_style_prefer_index_operator = true:suggestion
csharp_style_throw_expression = true:suggestion
csharp_style_conditional_delegate_call = true:suggestion
csharp_prefer_braces = when_multiline:suggestion
csharp_prefer_simple_using_statement = true:suggestion
csharp_style_prefer_top_level_statements = true:silent

dotnet_style_coalesce_expression = true:suggestion
dotnet_style_null_propagation = true:suggestion
dotnet_style_object_initializer = true:suggestion
dotnet_style_collection_initializer = true:suggestion
dotnet_style_prefer_conditional_expression_over_assignment = true:silent
dotnet_style_prefer_conditional_expression_over_return = true:silent
dotnet_style_readonly_field = true:warning
dotnet_style_require_accessibility_modifiers = for_non_interface_members:warning

# --- this. innecesario ---
dotnet_style_qualification_for_field = false:warning
dotnet_style_qualification_for_property = false:warning
dotnet_style_qualification_for_method = false:warning
dotnet_style_qualification_for_event = false:warning

# --- Nuevas líneas ---
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_new_line_before_members_in_object_initializers = true

# --- Espacios ---
csharp_space_after_cast = false
csharp_space_after_keywords_in_control_flow_statements = true
csharp_space_between_method_declaration_parameter_list_parentheses = false
csharp_space_between_method_call_parameter_list_parentheses = false

# --- Convenciones de nombres ---
dotnet_naming_rule.interfaces_deben_empezar_con_i.severity = warning
dotnet_naming_rule.interfaces_deben_empezar_con_i.symbols = interfaz
dotnet_naming_rule.interfaces_deben_empezar_con_i.style = prefijo_i
dotnet_naming_symbols.interfaz.applicable_kinds = interface
dotnet_naming_style.prefijo_i.required_prefix = I
dotnet_naming_style.prefijo_i.capitalization = pascal_case

dotnet_naming_rule.tipos_en_pascal_case.severity = warning
dotnet_naming_rule.tipos_en_pascal_case.symbols = tipos
dotnet_naming_rule.tipos_en_pascal_case.style = pascal_case
dotnet_naming_symbols.tipos.applicable_kinds = class, struct, enum, delegate, event, method, property
dotnet_naming_style.pascal_case.capitalization = pascal_case

dotnet_naming_rule.campos_privados_con_underscore.severity = warning
dotnet_naming_rule.campos_privados_con_underscore.symbols = campos_privados
dotnet_naming_rule.campos_privados_con_underscore.style = prefijo_underscore
dotnet_naming_symbols.campos_privados.applicable_kinds = field
dotnet_naming_symbols.campos_privados.applicable_accessibilities = private
dotnet_naming_style.prefijo_underscore.required_prefix = _
dotnet_naming_style.prefijo_underscore.capitalization = camel_case

dotnet_naming_rule.constantes_en_pascal_case.severity = warning
dotnet_naming_rule.constantes_en_pascal_case.symbols = constantes
dotnet_naming_rule.constantes_en_pascal_case.style = pascal_case
dotnet_naming_symbols.constantes.applicable_kinds = field
dotnet_naming_symbols.constantes.required_modifiers = const

# --- Analizadores: excepciones justificadas ---
# CA1848: LoggerMessage delegates. Ganancia marginal para el ruido que genera.
dotnet_diagnostic.CA1848.severity = none
# CA1727: no exigimos PascalCase en los nombres de plantilla de log.
dotnet_diagnostic.CA1727.severity = none
# CA2007: ConfigureAwait no aplica en ASP.NET Core (no hay SynchronizationContext).
dotnet_diagnostic.CA2007.severity = none
# CA1014: CLSCompliant solo importa en librerías públicas consumidas desde otros lenguajes .NET.
dotnet_diagnostic.CA1014.severity = none

[src/Domain/Ecf/*.cs]
# CA1720: "signed" figura como designación de tipo CLI, pero en el vocabulario del
# e-CF ("firmado") es un falso positivo recurrente (EcfStatus.Signed, FromSigned…).
dotnet_diagnostic.CA1720.severity = none

[src/Application/Ecf/Interfaces/IEcfSubmissionQueue.cs]
# CA1711: "Queue" describe con precisión lo que es — la cola de envío del outbox.
dotnet_diagnostic.CA1711.severity = none

[tests/**/*.cs]
# En pruebas los nombres de método describen el escenario; no forzamos PascalCase estricto.
dotnet_diagnostic.CA1707.severity = none
# CA1711: xUnit exige que la clase de CollectionDefinition se llame "...Collection".
dotnet_diagnostic.CA1711.severity = none

[**/Persistence/EfCore/Migrations/*.cs]
# Código generado por `dotnet ef migrations`. No lo editamos por estilo.
dotnet_diagnostic.CA1861.severity = none
dotnet_diagnostic.CA1002.severity = none
