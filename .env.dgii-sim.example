# Copia este archivo a `.env` (que está en .gitignore) para probar el pipeline
# completo contra el simulador de la DGII:
#
#   cp .env.dgii-sim.example .env
#   docker compose --profile dgii-sim up --build
#
# Con esto la API apunta a `dgii-sim` en vez de a la DGII real, y el worker de
# envío consulta el resultado a los 2 s (en vez de 30 s) para que la demo sea
# rápida. Borra el `.env` para volver a apuntar a la DGII real.

DGII_ECF_URL=http://dgii-sim:8080
DGII_FC_URL=http://dgii-sim:8080
ECF_FIRST_POLL_SECONDS=2
